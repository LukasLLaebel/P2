<div class="users-box hidden">

  <div class="user active-user">
    <div class="profile-pic">
      <img src="./" alt="PP"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';">
      <i class="fa-solid fa-user" style="display: none"></i>
    </div>
    <div class="name">Jeff</div>
    <div class="remove">X</div>
  </div>

  <div class="user">
    <div class="profile-pic">
      <img src="./" alt="PP"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';">
      <i class="fa-solid fa-user" style="display: none"></i>
    </div>
    <div class="name">Søren</div>
  </div>

  <div class="user">
    <div class="profile-pic">
      <img src="./" alt="PP"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';">
      <i class="fa-solid fa-user" style="display: none"></i>
    </div>
    <div class="name">Laura</div>
  </div>

</div>

<div class="popup-overlay hidden" id="addUserPopup">
  <div class="popup-box">
    <button class="close-popup" type="button">X</button>

    <h2>Add User</h2>

    <label for="username">Username</label>
    <input id="username" type="text" placeholder="Write username">

    <button class="popup-action-btn" type="button">Add</button>
  </div>
</div>

<div class="popup-overlay hidden" id="editRolePopup">
  <div class="popup-box">
    <button class="close-popup" type="button">X</button>

    <h2>Edit Role</h2>

    <label for="roleTitleInput">Role title</label>
    <input id="roleTitleInput" type="text" value="Admin">

    <button id="saveRoleTitleBtn" class="popup-action-btn" type="button">Save</button>
  </div>
</div>

<div class="popup-overlay hidden" id="deleteRolePopup">
  <div class="popup-box">
    <button class="close-popup" type="button">X</button>

    <h2>Delete Role</h2>

    <p>Are you sure you want to delete this role?</p>

    <button class="popup-action-btn" type="button">Yes, delete</button>
  </div>
</div>