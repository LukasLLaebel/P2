<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title></title>
  <link href="./css/my-files.css" rel="stylesheet">
  <link href="./css/empty.folderpages.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    integrity="sha512-yf5A4nTm5Z/..." crossorigin="anonymous" referrerpolicy="no-referrer">
</head>

<body>
  <header>
    <h1>Username</h1>
    <div class="profile-pic">
      <img src="./" alt="PP" onerror="
            this.style.display = 'none';
            this.nextElementSibling.style.display = 'inline-block';
          ">
      <i class="fa-solid fa-user" style="display: none"></i>
    </div>
  </header>
  <aside>
    <%- include("./assets/navbar.ejs") %>
  </aside>
  <main>
    <div class="item-wrapper">
      <h1 class="title">My Files</h1>
      <div class="folder-wrapper">
        <% if (userFolders && userFolders.length> 0) { %>
          <% userFolders.forEach((folder, index)=> { %>
            <div class="folder-<%= String(index + 1).padStart(2, '0') %>">
              <h1>
                <%= folder.name %>
              </h1>
              <div class="btn-wrapper">
                <h2 style="background-color: <%= folder.owner === currentUser ? '#404e3b' : '#7b9669' %>"
                  data-action="owner" data-folder-id="<%= folder.id %>">
                  <%= folder.owner===currentUser ? 'You' : folder.owner %>
                </h2>
                <h2 style="background-color: #6c8480" data-action="colab-users" data-folder-id="<%= folder.id %>"
                  data-users="<%= folder.users.join(', ') %>">
                  Users (<%= folder.users.length %>)
                </h2>
              </div>
            </div>
            <% }); %>
              <% } else { %>
                <%- include("./assets/empty.folderpages.ejs") %>
                  <% } %>
        <div class="add-folder-btn" id="addFolderBtn">
          <h1>+ New Folder</h1>
        </div>
      </div>
  </main>
  <script src="/js/addFolderBtn.js"></script>
</body>

</html>
